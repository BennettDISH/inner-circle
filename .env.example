PORT=3000
NODE_ENV=development

# PostgreSQL
DATABASE_URL=postgres://user:password@localhost:5432/inner_circle

# Local JWT
JWT_SECRET=change-me-to-something-long-and-random

# Central SSO Auth Service
AUTH_SERVICE_URL=https://harmonious-ambition-production.up.railway.app
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=

# Frontend (Vite-exposed)
VITE_AUTH_SERVICE_URL=https://harmonious-ambition-production.up.railway.app
VITE_SSO_CLIENT_ID=

# Optional admin user IDs (comma-separated central_user_id values)
ADMIN_CENTRAL_USER_IDS=
