PORT=3000
NODE_ENV=development

# PostgreSQL
DATABASE_URL=postgres://user:password@localhost:5432/inner_circle

# Local JWT
JWT_SECRET=change-me-to-something-long-and-random

# Central SSO Auth Service (server-side only; the client never sees these)
AUTH_SERVICE_URL=https://harmonious-ambition-production.up.railway.app
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=

# Optional: exact public base URL used to build the SSO redirect_uri.
# Falls back to the request origin (needs `trust proxy`, already set) when unset.
# APP_BASE_URL=https://your-app.up.railway.app

# Optional admin user IDs (comma-separated central_user_id values)
ADMIN_CENTRAL_USER_IDS=
